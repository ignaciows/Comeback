{
  "expo": {
    "name": "Comeback",
    "slug": "comeback",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "comeback",
    "platforms": [
      "ios",
      "android"
    ],
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0B0D",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.comeback.training",
      "infoPlist": {
        "UIUserInterfaceStyle": "Dark"
      }
    },
    "android": {
      "package": "com.comeback.training",
      "adaptiveIcon": {
        "backgroundColor": "#0A0B0D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0A0B0D"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Comeback uses your location to find gyms near you, and \u2014 only if you turn weather on \u2014 to check local conditions. It is rounded to about 11 km before it is sent and never stored."
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Comeback reads your sleep, body weight, heart rate and the meals you log in MIKUY to work out how recovered and how fuelled you are.",
          "NSHealthUpdateUsageDescription": "Comeback never writes to Health."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1aa87774-5b7c-40fd-b20a-eb0380f45c7f"
      }
    },
    "owner": "parkyparking",
    "updates": {
      "url": "https://u.expo.dev/1aa87774-5b7c-40fd-b20a-eb0380f45c7f",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 10000
    }
  }
}
